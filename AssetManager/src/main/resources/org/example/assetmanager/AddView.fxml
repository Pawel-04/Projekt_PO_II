<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="600" prefWidth="500" spacing="15" style="-fx-padding: 40; -fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="org.example.assetmanager.view.MainController">
    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Nowy Przedmiot w Ewidencji" />

    <GridPane alignment="CENTER" hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>

        <Label text="Nazwa:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nazwaInput" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Kategoria:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="kategoriaBox" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Lokalizacja:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="locationBox" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Data zakupu:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <Label text="Cena jedn. (zł):" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextField fx:id="wartoscInput" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <Label text="Ilość sztuk:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <TextField fx:id="iloscInput" text="1" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <Label text="Gwarancja (m-ce):" GridPane.columnIndex="0" GridPane.rowIndex="6" />
        <TextField fx:id="gwarancjaInput" GridPane.columnIndex="1" GridPane.rowIndex="6" />
    </GridPane>

    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#handleSelectFile" text="Wybierz zdjęcie paragonu" />
        <Label fx:id="filePathLabel" style="-fx-text-fill: gray;" text="Brak pliku" />
    </HBox>

    <HBox alignment="CENTER" spacing="20">
        <Button onAction="#saveNewItem" styleClass="btn-success" text="Zapisz do bazy" />
        <Button onAction="#goBack" text="Anuluj" />
    </HBox>
</VBox>
