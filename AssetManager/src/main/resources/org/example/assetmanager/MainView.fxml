<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainBorderPane" prefHeight="600" prefWidth="900"
            xmlns="http://javafx.com/javafx/17.0.12" fx:controller="org.example.assetmanager.view.MainController">
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="220.0" spacing="10.0"
              style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">

            <padding>
                <Insets top="20.0"/>
            </padding>

            <Label text="AssetManager" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
                <VBox.margin>
                    <Insets bottom="20.0"/>
                </VBox.margin>
            </Label>

            <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#showDashboard" prefHeight="45.0"
                    prefWidth="220.0" text="Pulpit" textFill="WHITE"/>

            <Button fx:id="btnPrivate" mnemonicParsing="false" onAction="#showPrivateAssets" prefHeight="45.0"
                    prefWidth="220.0" text="Majątek Prywatny" textFill="WHITE"/>

            <Button fx:id="btnCompany" mnemonicParsing="false" onAction="#showCompanyAssets" prefHeight="45.0"
                    prefWidth="220.0" text="Sprzęt Firmowy" textFill="WHITE"/>

            <Button fx:id="btnCategories" mnemonicParsing="false" onAction="#showCategoryCRUD" prefHeight="45.0"
                    prefWidth="220.0" text="Kategorie" textFill="WHITE"/>

            <Button fx:id="btnLocations" mnemonicParsing="false" onAction="#showLocationCRUD" prefHeight="45.0"
                    prefWidth="220.0" text="Lokalizacje" textFill="WHITE"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button mnemonicParsing="false" onAction="#closeApp" prefHeight="45.0" prefWidth="220.0" text="Zamknij"
                    textFill="#bdc3c7"
                    style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-padding: 0 0 0 20;">
                <VBox.margin>
                    <Insets bottom="20.0"/>
                </VBox.margin>
            </Button>

        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" style="-fx-background-color: #ecf0f1;">
            <Label style="-fx-text-fill: gray; -fx-font-size: 18px;" text="Ładowanie..."/>
        </VBox>
    </center>
</BorderPane>